PORT=3000

# Supabase Production Backend Configuration
# Add these variables to Netlify (Site Settings -> Environment Variables)
# and to your local .env file
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Optional: Service Role Key ONLY for running offline database migration scripts (NEVER expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
